# ОБОВ'ЯЗКОВО встановити перед запуском (без дефолту!)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (для production). Для локального старту можна лишити SQLite (DB_ENGINE=sqlite)
DB_ENGINE=sqlite
DB_NAME=hr_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS — дозволені origins (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
